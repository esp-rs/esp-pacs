              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>TIMER_SET</name>
              <description>TWAI FD timer set register.
1b0: Not enable
1b1: Enable to set value to ld_val.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>TIMER_UP_DN</name>
              <description>TWAI FD timer up/down count register.
1b0: Count-down
1b1: Count-up</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TIMER_STEP</name>
              <description>TWAI FD timer count step register, step=reg_timer_step+1</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
