              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CHNL0_INT_ENA</name>
          <description>Interrupt enable bits</description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>CHNL0_OUTCNT_EOF_INT_ENA</name>
              <description>This is the enable bit for reg_out_cnt_eof_int_st register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CHNL0_OUTFIFO_EOF_INT_ENA</name>
              <description>This is the enable bit for reg_outfifo_eof_int_st register.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CHNL0_INT_CLR</name>
          <description>Interrupt clear bits</description>
          <addressOffset>0x2c</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>CHNL0_OUTCNT_EOF_INT_CLR</name>
              <description>Set this bit to clear the reg_out_cnt_eof_int_raw interrupt.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>CHNL0_OUTFIFO_EOF_INT_CLR</name>
              <description>Set this bit to clear the reg_outfifo_eof_int_raw interrupt.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
