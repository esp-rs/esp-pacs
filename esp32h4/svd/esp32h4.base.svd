          <description>Interrupt enable bits</description>
          <addressOffset>0x64</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>CHNL1_OUTCNT_EOF_INT_ENA</name>
              <description>This is the enable bit for reg_out_cnt_eof_int_st register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CHNL1_OUTFIFO_EOF_INT_ENA</name>
              <description>This is the enable bit for reg_outfifo_eof_int_st register.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
