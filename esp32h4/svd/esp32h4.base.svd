          <name>EWL_ERP_FAULT_STATE</name>
          <description>TWAI FD error threshold and status register</description>
          <addressOffset>0x2c</addressOffset>
          <size>32</size>
          <resetValue>0x48060</resetValue>
          <fields>
            <field>
              <name>EW_LIMIT</name>
              <description>Error warning limit. If error warning limit is reached interrupt can be generated. Error warning limit
indicates heavily disturbed bus.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ERP_LIMIT</name>
              <description>Error Passive Limit. When one of error counters (REC/TEC) exceeds this value, Fault confinement state
changes to error-passive.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ERA</name>
              <description>Represents the fault state of error active.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ERP</name>
              <description>Represents the fault state of error passive.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>BOF</name>
              <description>Represents the fault state of bus off.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
