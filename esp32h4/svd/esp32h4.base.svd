        <register>
          <name>BACKUP_DMA_CFG0</name>
          <description>configure regdma always on register</description>
          <addressOffset>0x70</addressOffset>
          <size>32</size>
          <resetValue>0x14a</resetValue>
          <fields>
            <field>
              <name>BURST_LIMIT_AON</name>
              <description>Set this field to configure max value of burst in signle transfer.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>READ_INTERVAL_AON</name>
              <description>Set this field to configure read registers' interval time in reading mode.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>BRANCH_LINK_LENGTH_AON</name>
              <description>Set this field to configure link address.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>REGDMA_ERROR</name>
              <description>regdma error code</description>
              <bitOffset>16</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BACKUP_DMA_CFG1</name>
          <description>configure regdma always on register</description>
          <addressOffset>0x74</addressOffset>
          <size>32</size>
          <resetValue>0x6419064</resetValue>
          <fields>
            <field>
              <name>LINK_WAIT_TOUT_THRES_AON</name>
              <description>Set this field to configure the number of consecutive links of link list.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>10</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>LINK_WORK_TOUT_THRES_AON</name>
              <description>Set this field to configure maximum waiting time in waiting mode.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>10</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>LINK_BACKUP_TOUT_THRES_AON</name>
              <description>Set this field to configure maximum waiting time in backup mode.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>10</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>AON_BYPASS</name>
              <description>reserved</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
