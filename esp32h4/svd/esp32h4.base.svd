              <description>Protocol control state machine is in CRC field.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>PC_CRCD</name>
              <description>Protocol control state machine is in CRC Delimiter field.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>PC_ACK</name>
