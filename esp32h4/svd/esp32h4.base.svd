      <name>MEM_MONITOR</name>
      <description>MEM_MONITOR Peripheral</description>
      <groupName>MEM_MONITOR</groupName>
      <baseAddress>0x60025000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x3c</size>
