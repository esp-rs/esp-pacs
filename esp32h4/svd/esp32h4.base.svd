              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>PC_ACKD</name>
              <description>Protocol control state machine is in ACK Delimiter field.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
