            <field>
              <name>L1_CACHE_PRELOAD_ADDR</name>
              <description>Configures the starting virtual address for the preloading operation in the L1 cache. This field should be configured together with CACHE_L1_CACHE_PRELOAD_SIZE_REG.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>L1_CACHE_PRELOAD_SIZE</name>
          <description>L1 cache preloading size configuration register</description>
          <addressOffset>0xe4</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>L1_CACHE_PRELOAD_SIZE</name>
