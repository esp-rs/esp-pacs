          <addressOffset>0x74</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>RX_MESSAGE_COUNTER</name>
              <description>Reflects the number of messages available within the RXFIFO. The value is incremented with each receive event and decremented by the release receive buffer command.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
