            </field>
            <field>
              <name>SW_STANDBY_CLR</name>
              <description>Clear standby pin.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
