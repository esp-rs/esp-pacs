              <name>CD</name>
              <description>These bits are used to define the frequency at the external CLKOUT pin.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CLOCK_OFF</name>
              <description>1: Disable the external CLKOUT pin. 0: Enable the external CLKOUT pin. Software has R/W permission in reset mode and RO in operation mode.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SW_STANDBY_CFG</name>
          <description>Software configure standby pin directly.</description>
          <addressOffset>0x80</addressOffset>
          <size>32</size>
          <resetValue>0x2</resetValue>
          <fields>
