          <size>32</size>
          <resetValue>0x1000000</resetValue>
          <fields>
            <field>
              <name>TIMER_DUTY_RES</name>
              <description>This register is used to control the range of the counter in timer %s.</description>
              <bitOffset>0</bitOffset>
