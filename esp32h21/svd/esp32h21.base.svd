            <field>
              <name>SEC_DPA_LEVEL</name>
              <description>Represents the security level of anti-DPA attack. The level is adjusted by configuring the clock random frequency division mode.\\ 0: Security level is SEC_DPA_OFF\\ 1: Security level is SEC_DPA_LOW\\ 2: Security level is SEC_DPA_MIDDLE\\ 3: Security level is SEC_DPA_HIGH\\ For more information, please refer to Chapter mod:sysreg &gt; Section sec:sysreg-anti-dpa-attack-security-control.\\</description>
              <bitOffset>16</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
            </field>
