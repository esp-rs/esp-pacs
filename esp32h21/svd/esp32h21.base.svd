        <register>
          <name>L1_CACHE_PRELOAD_CTRL</name>
          <description>L1 cache preloading operation control register</description>
          <addressOffset>0xdc</addressOffset>
          <size>32</size>
          <resetValue>0x2</resetValue>
          <fields>
            <field>
              <name>L1_CACHE_PRELOAD_ENA</name>
              <description>Configures whether to enable the preloading operation in the L1 cache. It will be cleared by hardware automatically after the preloading operation is done.\\
0: Disable\\
1: Enable\\</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>L1_CACHE_PRELOAD_DONE</name>
              <description>Represents whether the preloading operation is finished.\\
0: Not finished\\
1: Finished\\</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>L1_CACHE_PRELOAD_ORDER</name>
              <description>Configures the direction of the preloading operation.\\
0: Ascending\\
1: Descending\\</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>L1_CACHE_PRELOAD_RGID</name>
              <description>The bit is used to set  the gid of l1 Cache preload.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
