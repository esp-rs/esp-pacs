              <name>DB1_FED_UPMETHOD</name>
              <description>Update method for FED (falling edge delay) active register. 0: immediate, when bit0 is set to 1: tez, when bit1 is set to 1:tep,  when bit2 is set to 1: sync, when bit3 is set to 1: disable the update</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
