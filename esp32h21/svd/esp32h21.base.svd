          <addressOffset>0x40</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>PULSE_CNT_U</name>
              <description>Represents the current pulse count value for unit %s.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
