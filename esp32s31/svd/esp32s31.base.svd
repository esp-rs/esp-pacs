    <peripheral>
      <name>CACHE</name>
      <description>CACHE Peripheral</description>
      <groupName>CACHE</groupName>
      <baseAddress>0x2c000000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x3f4</size>
