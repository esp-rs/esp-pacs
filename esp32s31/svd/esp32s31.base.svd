              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>OUT_ECC_AEC_EN_CH1</name>
              <description>1: mean access ecc or aes domain,0: mean not</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
