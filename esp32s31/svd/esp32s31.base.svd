          <resetValue>0x2</resetValue>
          <fields>
            <field>
              <name>L1_ICACHE0_PRELOAD_ENA</name>
              <description>Configures whether to enable the preloading operation in icache0. Hardware will clear it once the operation has finished.\\1: Enable\\</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
