        <register>
          <name>QUICK_SENT</name>
          <description>UHCI quick send configuration register</description>
          <addressOffset>0x30</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>SINGLE_SEND_NUM</name>
              <description>Configures the source of data to be transmitted in single_send mode.\\
0: Q0 register\\
1: Q1 register\\
2: Q2 register\\
3: Q3 register\\
4: Q4 register\\
5: Q5 register\\
6: Q6 register\\
7: Invalid. No effect\\</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SINGLE_SEND_EN</name>
              <description>Write 1 to enable single_send mode.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>ALWAYS_SEND_NUM</name>
              <description>Configures the source of data to be transmitted in always_send mode.\\
0: Q0 register\\
1: Q1 register\\
2: Q2 register\\
3: Q3 register\\
4: Q4 register\\
5: Q5 register\\
6: Q6 register\\
7: Invalid. No effect\\</description>
              <bitOffset>4</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ALWAYS_SEND_EN</name>
              <description>Configures whether or not to enable always_send mode.\\
0: Disable\\
1: Enable\\</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
