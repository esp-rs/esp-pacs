          <addressOffset>0x94</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>LOCK_ADDR</name>
              <description>Configures the start address of the lock/unlock operation, which should be used together with CACHE_LOCK_SIZE_REG</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LOCK_SIZE</name>
          <description>Lock (manual lock) size configure register</description>
          <addressOffset>0x98</addressOffset>
          <size>32</size>
          <fields>
