          <size>32</size>
          <resetValue>0xffffffff</resetValue>
          <fields>
            <field>
              <name>ADDRLO_3</name>
              <description>This register is present only when Enable MAC Address3 is selected in coreConsultant _See Table 78_</description>
              <bitOffset>0</bitOffset>
