    <peripheral>
      <name>ECDSA</name>
      <description>ECDSA (Elliptic Curve Digital Signature Algorithm) Accelerator</description>
      <groupName>ECDSA</groupName>
      <baseAddress>0x2050e000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1a0</size>
