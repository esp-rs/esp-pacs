            </field>
          </fields>
        </register>
        <register>
          <name>CHNL1_CFG0</name>
          <description>Control and configuration registers</description>
          <addressOffset>0x3c</addressOffset>
          <size>32</size>
          <resetValue>0x7</resetValue>
          <fields>
            <field>
              <name>CHNL1_RS2_STG1_BYPASS</name>
              <description>Set this bit to bypass stage 1 re-sampler in channel1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CHNL1_RS2_STG0_BYPASS</name>
              <description>Set this bit to bypass stage 0 re-sampler in channel1.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CHNL1_FRAC_BYPASS</name>
              <description>Set this bit to bypass fractional re-sampler in channel1.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CHNL1_RS2_STG1_MODE</name>
              <description>Write this bit to configure stage 1 re-sampler mode in channel1, 0: interpolation by  factor of 2, 1: decimation by  factor of 2.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CHNL1_RS2_STG0_MODE</name>
              <description>Write this bit to configure stage 0 re-sampler mode in channel1, 0: interpolation by  factor of 2, 1: decimation by  factor of 2.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CHNL1_FRAC_AHEAD</name>
              <description>Set this bit to move fraction re-sampler to the first stage in channel1, it should be 1 when input frequency is higher the output.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CHNL1_RS2_SELPHASE0</name>
              <description>Set this bit to disable shift phase when 2 interpolation by factor of 2 in channel1.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CHNL1_MODE</name>
              <description>Write the bit to configure the channel mode,0: in and out are both mono, 1: in and out is both dual, 2: in is mono, out is dual, 3, in is dual, out is mono.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CHNL1_SEL</name>
              <description>Write the bit to configure which 16bits data will be processing.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CHNL1_CFG1</name>
          <description>Control and configuration registers</description>
          <addressOffset>0x40</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>CHNL1_FRAC_M</name>
              <description>Write the bits to specify the denominator of factor of fraction re-sampler in channel1, reg_chnl0_frac_m and reg_chnl0_frac_l are relatively prime.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>10</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CHNL1_FRAC_L</name>
              <description>Write the bits to specify the nominator of factor of fraction re-sampler in channel1, reg_chnl0_frac_l and reg_chnl0_frac_m are relatively prime.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>10</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CHNL1_CFG2</name>
          <description>Control and configuration registers</description>
          <addressOffset>0x44</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>CHNL1_FRAC_RECIPL</name>
              <description>Write the bits with ((2^19+L)/(2L)) round down in channel1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>20</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CHNL1_CFG3</name>
          <description>Control and configuration registers</description>
          <addressOffset>0x48</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>CHNL1_RESET</name>
              <description>Set this bit to reset channel1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CHNL1_CFG4</name>
          <description>Control and configuration registers</description>
          <addressOffset>0x4c</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>CHNL1_START</name>
              <description>Set this bit to start channel1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CHNL1_CFG5</name>
          <description>Control and configuration registers</description>
          <addressOffset>0x50</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>CHNL1_IN_CNT_ENA</name>
              <description>Set this bit to enable in data byte counter.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CHNL1_IN_CNT_CLR</name>
              <description>Set this bit to clear in data byte counter.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>CHNL1_IN_LEN</name>
              <description>Write the bits to specify the data byte numbers of data from the DMA</description>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CHNL1_CFG6</name>
          <description>Control and configuration registers</description>
          <addressOffset>0x54</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>CHNL1_OUT_EOF_GEN_MODE</name>
              <description>Write the bits to specify the which eof will be written to DMA. 0:  counter eof, 1: DMA ineof, 2: both counter eof and DMA ineof, 3 none.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CHNL1_OUT_CNT_ENA</name>
              <description>Set this bit to enable out data byte counter.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CHNL1_OUT_CNT_CLR</name>
              <description>Set this bit to clear out data byte counter.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>CHNL1_OUT_SAMPLES_COMP</name>
              <description>Set this bit to enable out data byte counter compensation when using fractional re-sampler and decimation by factor of 2 which results in reg_chnl1_out_cnt &gt;= reg_chnl1_out_len</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CHNL1_OUT_LEN</name>
              <description>Write the bits to specify the data byte number of data to the DMA, the counter eof will be set when the counter approaches.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
