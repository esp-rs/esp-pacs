              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>Y_YUV_TX_SCALE_ERR_ST</name>
              <description>The error is that the va/vb/y param in dma2d descriptor is an odd num when enable yuv420 tx</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
