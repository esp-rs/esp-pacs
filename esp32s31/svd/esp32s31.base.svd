          <addressOffset>0x74</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>TX_IDEAL_CNT</name>
              <description>tx fifo counter ideal value.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>31</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
