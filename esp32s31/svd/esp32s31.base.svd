    <peripheral>
      <name>DAC</name>
      <description>DAC Peripheral</description>
      <groupName>DAC</groupName>
      <baseAddress>0x2081a000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x44</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>LP_DAC</name>
        <value>145</value>
      </interrupt>
      <registers>
        <register>
          <name>PAD_CFG</name>
          <description>configure dac pad register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <resetValue>0x4000</resetValue>
          <fields>
            <field>
              <name>HS_MODE_PAD_0</name>
              <description>1 to let DAC PAD 0 enter High speed mode</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>XPD_PAD_0</name>
              <description>1 to power on DAC PAD 0</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EN_ADC_MUX_PAD_0</name>
              <description>1 to enable adc mux for DAC PAD 0</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DSAMP_LS_PAD_0</name>
              <description>1 to start sample and hold mode for DAC PAD 0</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DCAL_LS_PAD_0</name>
              <description>1 to Calibrate the buffer of DAC PAD 0 (DBUF of pad 1 must be 1 during this operation)</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DBUF_LS_PAD_0</name>
              <description>1 to turn on the buffer of DAC PAD 0</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ON_LS_PAD_0</name>
              <description>1 to turn on the DAC PAD 0 during sample and hold mode</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>HS_MODE_PAD_1</name>
              <description>1 to let DAC PAD 1 enter High speed mode</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>XPD_PAD_1</name>
              <description>1 to power on DAC PAD 1</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EN_ADC_MUX_PAD_1</name>
              <description>1 to enable adc mux for DAC PAD 1</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DSAMP_LS_PAD_1</name>
              <description>1 to start sample and hold mode for DAC PAD 1</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DCAL_LS_PAD_1</name>
              <description>1 to Calibrate the buffer of DAC PAD 1 (DBUF of pad 1 must be 1 during this operation)</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DBUF_LS_PAD_1</name>
              <description>1 to turn on the buffer of DAC PAD 1</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ON_LS_PAD_1</name>
              <description>1 to turn on the DAC PAD 1 during sample and hold mode</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DIV_NUM</name>
              <description>divide number between clk ls and clk hs</description>
              <bitOffset>14</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DBUF_RANGE_LS_PAD_0</name>
              <description>1:when buffer is activated, allow using full code of maximum bitwidth
0:when buffer is not activated, should always be 0</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DBUF_RANGE_LS_PAD_1</name>
              <description>1:when buffer is activated, allow using full code of maximum bitwidth
0:when buffer is not activated, should always be 0</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
