          <fields>
            <field>
              <name>CHNL1_OUT_CNT</name>
              <description>Represents the data byte numbers send to the DMA when EOF occurs.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>24</bitWidth>
              <access>read-only</access>
            </field>
