            <field>
              <name>CHNL0_OUTFIFO_EOF_INT_ST</name>
              <description>This is the status bit for reg_outfifo_eof_int_raw when reg_outfifo_eof_int_ena is set to 1.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CHNL0_INT_ENA</name>
          <description>Interrupt enable bits</description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <fields>
