              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>X_FACTOR</name>
              <description>horizontal sampling factor of c1</description>
              <bitOffset>12</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ID</name>
              <description>the identifier of c1</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>C2</name>
