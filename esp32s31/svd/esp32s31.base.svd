        <register>
          <dim>2</dim>
          <dimIncrement>0x100</dimIncrement>
          <name>AHB_DMA_IN_POP_CH%s</name>
          <description>Pop control register of RX channel %s</description>
          <addressOffset>0x10c</addressOffset>
          <size>32</size>
          <resetValue>0x800</resetValue>
          <fields>
            <field>
              <name>AHB_DMA_INFIFO_RDATA_CH</name>
