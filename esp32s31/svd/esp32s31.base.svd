          <addressOffset>0x64</addressOffset>
          <size>32</size>
          <resetValue>0xbad3000</resetValue>
          <fields>
            <field>
              <name>OUT_COLOR_PARAM_L1_CH</name>
              <description>Set last 2 parameter of least significant byte of pending 3 bytes</description>
              <bitOffset>0</bitOffset>
              <bitWidth>28</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>4</dim>
          <dimIncrement>0x100</dimIncrement>
          <name>OUT_ETM_CONF_CH%s</name>
          <description>Configures the tx etm of channel %s</description>
          <addressOffset>0x68</addressOffset>
          <size>32</size>
          <resetValue>0x4</resetValue>
          <fields>
            <field>
              <name>OUT_ETM_EN_CH</name>
              <description>Configures the enable of the etm function, 1 is enable.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>OUT_ETM_LOOP_EN_CH</name>
              <description>Configures the enable of the descriptors loop etm function, 1 is enable.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>OUT_DSCR_TASK_MAK_CH</name>
              <description>Configures the maximum number of cacheable descriptors.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>4</dim>
          <dimIncrement>0x100</dimIncrement>
          <name>OUT_DSCR_PORT_BLK_CH%s</name>
