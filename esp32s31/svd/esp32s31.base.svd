          <fields>
            <field>
              <name>TX_FIFO_CNT</name>
              <description>tx fifo counter value.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>31</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TX_FIFO_CNT_RST</name>
