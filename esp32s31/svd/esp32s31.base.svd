              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>OUT_RO_RAM_CLK_FO_CH</name>
              <description>1: Force to open the clock and bypass the gate-clock when accessing the RAM in DMA. 0: A gate-clock will be used when accessing the RAM in DMA.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>4</dim>
          <dimIncrement>0x100</dimIncrement>
          <name>OUT_COLOR_CONVERT_CH%s</name>
          <description>Configures the tx color convert of channel %s</description>
          <addressOffset>0x48</addressOffset>
          <size>32</size>
          <resetValue>0x38</resetValue>
          <fields>
            <field>
              <name>OUT_COLOR_OUTPUT_SEL_CH</name>
              <description>Set final color convert process and output type    0: RGB888 to RGB565     1: YUV444 to YUV422     2: output directly</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>OUT_COLOR_3B_PROC_EN_CH</name>
              <description>Enable generic color convert modlue between color input &amp; color output, need to configure parameter.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>OUT_COLOR_INPUT_SEL_CH</name>
              <description>Set first color convert process and input color type    0: RGB565 to RGB888     1: YUV422 to YUV444      2: Other 2byte/pixel type    3: Other 3byte/pixel type    7: disable color space convert</description>
              <bitOffset>3</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>4</dim>
          <dimIncrement>0x100</dimIncrement>
          <name>OUT_SCRAMBLE_CH%s</name>
          <description>Configures the tx scramble of channel %s</description>
          <addressOffset>0x4c</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>OUT_SCRAMBLE_SEL_PRE_CH</name>
              <description>Scramble data before color convert :  0 : BYTE2-1-0   1 : BYTE2-0-1    2 : BYTE1-0-2    3 : BYTE1-2-0    4 : BYTE0-2-1    5 : BYTE0-1-2</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>4</dim>
          <dimIncrement>0x100</dimIncrement>
          <name>OUT_COLOR_PARAM0_CH%s</name>
          <description>Configures the tx color convert parameter of channel %s</description>
          <addressOffset>0x50</addressOffset>
          <size>32</size>
          <resetValue>0x12a</resetValue>
          <fields>
            <field>
              <name>OUT_COLOR_PARAM_H0_CH</name>
              <description>Set first 2 parameter of most significant byte of pending 3 bytes</description>
              <bitOffset>0</bitOffset>
              <bitWidth>21</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>4</dim>
          <dimIncrement>0x100</dimIncrement>
          <name>OUT_COLOR_PARAM1_CH%s</name>
          <description>Configures the tx color convert parameter of channel %s</description>
          <addressOffset>0x54</addressOffset>
          <size>32</size>
          <resetValue>0xc86d999</resetValue>
          <fields>
            <field>
              <name>OUT_COLOR_PARAM_H1_CH</name>
