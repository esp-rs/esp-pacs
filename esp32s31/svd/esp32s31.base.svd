              <name>CHNL0_CLK_FO</name>
              <description>Set this bit to make channel0 clock free run.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CHNL1_CLK_FO</name>
              <description>Set this bit to make channel1 clock free run.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CHNL0_OUTFIFO_CLK_FO</name>
              <description>Set this bit to make channel0 outfifo clock free run.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CHNL0_INFIFO_CLK_FO</name>
              <description>Set this bit to make channel0 infifo clock free run.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CHNL1_OUTFIFO_CLK_FO</name>
              <description>Set this bit to make channel1 outfifo clock free run.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
