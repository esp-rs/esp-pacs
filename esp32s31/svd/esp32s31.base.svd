1: set</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>ENORM</name>
              <description>Configures whether or not to erase the error counter of nominal bit time.
0: invalid
1: erase</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>EFD</name>
              <description>Configures whether or not to erase the error counter of data bit time.
0: invalid
1: erase</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
