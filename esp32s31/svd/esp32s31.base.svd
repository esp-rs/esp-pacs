          <fields>
            <field>
              <name>PRTADDR</name>
              <description>Port Address (PrtAddr)

This field is the port number of the recipient transaction translator.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>HUBADDR</name>
