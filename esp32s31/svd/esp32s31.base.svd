      </addressBlock>
      <interrupt>
        <name>CACHE</name>
        <value>69</value>
      </interrupt>
      <registers>
        <register>
          <name>L1_ICACHE_CTRL</name>
          <description>L1 instruction Cache(L1-ICache) control register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>L1_ICACHE_SHUT_IBUS0</name>
              <description>Configures whether to disable IBUS0 to access icache.\\1: Disable\\</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>L1_ICACHE_SHUT_IBUS1</name>
              <description>Configures whether to disable IBUS1 to access icache.\\1: Disable\\</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>L1_ICACHE_SHUT_IBUS2</name>
              <description>Configures whether to disable IBUS2 to access ROM cache.\\1: Disable\\</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>L1_ICACHE_SHUT_IBUS3</name>
              <description>Configures whether to disable IBUS3 to access ROM cache.\\1: Disable\\</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>L1_ICACHE_UNDEF_OP</name>
              <description>Reserved</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>L1_DCACHE_CTRL</name>
          <description>L1 data Cache(L1-DCache) control register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>L1_DCACHE_SHUT_DBUS0</name>
              <description>Configures whether to disable DBUS0 to access dcache.\\1: Disable\\</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>L1_DCACHE_SHUT_DBUS1</name>
              <description>Configures whether to disable DBUS1 to access dcache.\\1: Disable\\</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>L1_DCACHE_SHUT_DBUS2</name>
