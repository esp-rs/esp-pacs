              <name>LPCPU_STALL_WAIT_TIMER</name>
              <description>stall wait timer for lpcpu during lpcpu power off sequence</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>LPCPU_STALL_FLAG_EN</name>
              <description>1: wait for stall rdy input during lpcpu power off sequence
0:do not wait for stall rdy during lpcpu power off sequence</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>LPCPU_STALL_EN</name>
              <description>1: enable lpcpu stall during lpcpu power off sequence
0: disable lpcpu stall during lpcpu power off sequence</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>LPCPU_RESET_EN</name>
              <description>1: enable lpcpu reset during lpcpu power off sequence
0: disable lpcpu reset during lpcpu power off sequence</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>LPCPU_SLP_WAITI_FLAG_EN</name>
              <description>1: validates lp cpu waiti rdy signal during lpcpu power off sequence
0: invalidates lp cpu waiti rdy signal during lpcpu power off sequence</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>LPCPU_SLP_BYPASS_INTR_EN</name>
              <description>1: enable interrupt bypass signal for lpcpu during lpcpu power off sequence
0: disable interrupt bypass signal for lpcpu during lpcpu power off sequence</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
