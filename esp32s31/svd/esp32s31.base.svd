              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>X_FACTOR</name>
              <description>horizontal sampling factor of c2</description>
              <bitOffset>12</bitOffset>
              <bitWidth>4</bitWidth>
