          <addressOffset>0x34</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>WK_CHAR0</name>
              <description>Configures wakeup character 0.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SLEEP_CONF2</name>
