          <name>L1_CACHE_ADDR</name>
          <description>Cache address register</description>
          <addressOffset>0x268</addressOffset>
          <size>32</size>
          <resetValue>0x40000000</resetValue>
          <fields>
            <field>
              <name>L1_CACHE_ADDR</name>
