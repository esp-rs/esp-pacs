0: Mode 0\\
1: Mode 1\\
2: Mode 2\\
3: Mode 3\\</description>
              <bitOffset>26</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SWFC_CONF0_SYNC</name>
          <description>Software flow control character configuration</description>
          <addressOffset>0x3c</addressOffset>
          <size>32</size>
