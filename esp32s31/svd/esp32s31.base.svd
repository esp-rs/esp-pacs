              <access>read-only</access>
            </field>
            <field>
              <name>AHB_DMA_AHBINF_RESP_ERR_CH_ID</name>
              <description>Represents the AHB response error request channel id.bit[1]=1:TX channel.\\bit[1]=0:RX channel.\\</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
      </registers>
