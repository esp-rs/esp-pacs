        <register>
          <name>RX_RECOMB_DMA_CH3</name>
          <description>I2S RX recombined-dma-channel configuration register</description>
          <addressOffset>0x40</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>VALID</name>
              <description>Set this bit to enable the adc-dma-channel.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>STYLE</name>
