            </field>
            <field>
              <name>L1_ICACHE2_PRELOAD_MODE</name>
              <description>The bit is used to configure the mode of l1 icache2 preload, 0: load data from next level memory, 1: not load data from next level memory.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
