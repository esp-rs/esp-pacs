              <bitOffset>9</bitOffset>
              <bitWidth>9</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BLEND_ST</name>
          <description>Blending engine status register</description>
          <addressOffset>0x74</addressOffset>
          <size>32</size>
