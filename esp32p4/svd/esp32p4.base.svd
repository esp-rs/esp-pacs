          <resetValue>0x882</resetValue>
          <fields>
            <field>
              <name>SHARP_FILTER_COE10</name>
              <description>this field configures usm filter coefficient</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SHARP_FILTER_COE11</name>
              <description>this field configures usm filter coefficient</description>
              <bitOffset>5</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SHARP_FILTER_COE12</name>
