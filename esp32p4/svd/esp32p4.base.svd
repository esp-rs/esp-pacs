              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>FRAME_DONE_INT_RAW</name>
              <description>Raw status bit: The raw interrupt status of  H264_FRAME_DONE_INT. Triggered when H264 encoding one frame done.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DMA_MOVE_2MB_LINE_DONE_INT_RAW</name>
