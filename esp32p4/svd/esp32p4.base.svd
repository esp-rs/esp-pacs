              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>BS_BUFFER_OVERFLOW_INT_RAW</name>
              <description>Raw status bit: The raw interrupt status of H264_BS_BUFFER_OVERFLOW_INT. Triggered when H264 bit stream buffer overflow.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
