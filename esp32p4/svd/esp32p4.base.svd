    <peripheral>
      <name>DS</name>
      <description>Digital Signature</description>
      <groupName>DS</groupName>
      <baseAddress>0x50094000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0xa60</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <dim>512</dim>
          <dimIncrement>0x1</dimIncrement>
          <name>Y_MEM[%s]</name>
          <description>memory that stores Y</description>
          <addressOffset>0x0</addressOffset>
          <size>8</size>
        </register>
        <register>
          <dim>512</dim>
          <dimIncrement>0x1</dimIncrement>
          <name>M_MEM[%s]</name>
          <description>memory that stores M</description>
          <addressOffset>0x200</addressOffset>
          <size>8</size>
        </register>
        <register>
          <dim>512</dim>
          <dimIncrement>0x1</dimIncrement>
          <name>RB_MEM[%s]</name>
          <description>memory that stores Rb</description>
          <addressOffset>0x400</addressOffset>
          <size>8</size>
        </register>
        <register>
          <dim>48</dim>
          <dimIncrement>0x1</dimIncrement>
          <name>BOX_MEM[%s]</name>
          <description>memory that stores BOX</description>
          <addressOffset>0x600</addressOffset>
          <size>8</size>
        </register>
        <register>
          <dim>16</dim>
          <dimIncrement>0x1</dimIncrement>
          <name>IV_MEM[%s]</name>
          <description>memory that stores IV</description>
          <addressOffset>0x630</addressOffset>
          <size>8</size>
        </register>
        <register>
          <dim>512</dim>
          <dimIncrement>0x1</dimIncrement>
          <name>X_MEM[%s]</name>
          <description>memory that stores X</description>
          <addressOffset>0x800</addressOffset>
          <size>8</size>
        </register>
        <register>
          <dim>512</dim>
          <dimIncrement>0x1</dimIncrement>
          <name>Z_MEM[%s]</name>
          <description>memory that stores Z</description>
          <addressOffset>0xa00</addressOffset>
          <size>8</size>
        </register>
        <register>
          <name>SET_START</name>
          <description>Activates the DS module</description>
          <addressOffset>0xe00</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>SET_START</name>
              <description>Configures whether or not to activate the DS peripheral.\\
0: Invalid\\
1: Activate the DS peripheral\\</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SET_CONTINUE</name>
          <description>DS continue control register</description>
          <addressOffset>0xe04</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>SET_CONTINUE</name>
              <description>set this bit to continue DS operation.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SET_FINISH</name>
          <description>Ends DS operation</description>
          <addressOffset>0xe08</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>SET_FINISH</name>
              <description>Configures whether or not to end DS operation. \\
0: Invalid\\
1: End DS operation\\</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>QUERY_BUSY</name>
          <description>Status of the DS module</description>
          <addressOffset>0xe0c</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>QUERY_BUSY</name>
              <description>Represents whether or not the DS module is idle.\\
0: The DS module is idle\\
1: The DS module is busy\\</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>QUERY_KEY_WRONG</name>
          <description>Checks the reason why \begin{math}DS_KEY\end{math} is not ready</description>
          <addressOffset>0xe10</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>QUERY_KEY_WRONG</name>
              <description>Represents the specific problem with HMAC initialization.\\
0: HMAC is not called\\
1-15: HMAC was activated, but the DS peripheral did not successfully receive the \begin{math}DS_KEY\end{math} from the HMAC peripheral. (The biggest value is 15)\\</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>QUERY_CHECK</name>
          <description>Queries DS check result</description>
          <addressOffset>0xe14</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>MD_ERROR</name>
              <description>Represents whether or not the MD check passes.\\
0: The MD check passes\\
1: The MD check fails\\</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>PADDING_BAD</name>
              <description>Represents whether or not the padding check passes.\\
0: The padding check passes\\
1: The padding check fails\\</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>KEY_SOURCE</name>
          <description>DS configure key source register</description>
          <addressOffset>0xe18</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>KEY_SOURCE</name>
              <description>digital signature key source bit. \\
1'b0: key is from hmac.\\
1'b1: key is from key manager. \\</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DATE</name>
          <description>DS version control register</description>
          <addressOffset>0xe20</addressOffset>
          <size>32</size>
          <resetValue>0x20230901</resetValue>
          <fields>
            <field>
              <name>DATE</name>
              <description>ds version information</description>
              <bitOffset>0</bitOffset>
              <bitWidth>30</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>MIPI_DSI_BRIDGE</name>
      <description>MIPI Camera Interface Bridge</description>
      <groupName>DSI_BRG</groupName>
      <baseAddress>0x500a0800</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x98</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>DSI_BRIDGE</name>
        <value>86</value>
      </interrupt>
      <registers>
        <register>
          <name>CLK_EN</name>
          <description>dsi bridge clk control register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>CLK_EN</name>
              <description>this bit configures force_on of dsi_bridge register clock gate</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>EN</name>
          <description>dsi bridge en register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>DSI_EN</name>
              <description>this bit configures module enable of dsi_bridge. 0: disable, 1: enable</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DSI_BRIG_RST</name>
              <description>Configures software reset of dsi_bridge. 0: release reset, 1: reset</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DMA_REQ_CFG</name>
          <description>dsi bridge dma burst len register</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <resetValue>0x80</resetValue>
          <fields>
            <field>
              <name>DMA_BURST_LEN</name>
              <description>this field configures the num of 64-bit in one dma burst transfer, valid only when dsi_bridge as flow controller</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RAW_NUM_CFG</name>
          <description>dsi bridge raw number control register</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <resetValue>0x38400</resetValue>
          <fields>
            <field>
              <name>RAW_NUM_TOTAL</name>
              <description>this field configures number of total pix bits/64</description>
              <bitOffset>0</bitOffset>
              <bitWidth>22</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>UNALIGN_64BIT_EN</name>
              <description>this field configures whether the total pix bits is a multiple of 64bits. 0: align to 64-bit, 1: unalign to 64-bit</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RAW_NUM_TOTAL_SET</name>
              <description>this bit configures enable of reload reg_raw_num_total to internal cnt. 0: disable, 1: enable. valid only when dsi_bridge as flow controller</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RAW_BUF_CREDIT_CTL</name>
          <description>dsi bridge credit register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <resetValue>0x3200400</resetValue>
          <fields>
            <field>
              <name>CREDIT_THRD</name>
              <description>this field configures the threshold whether dsi_bridge fifo can receive one more 64-bit, valid only when dsi_bridge as flow controller</description>
              <bitOffset>0</bitOffset>
              <bitWidth>15</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CREDIT_BURST_THRD</name>
              <description>this field configures the threshold whether dsi_bridge fifo can receive one more dma burst, valid only when dsi_bridge as flow controller</description>
              <bitOffset>16</bitOffset>
              <bitWidth>15</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CREDIT_RESET</name>
              <description>this bit configures internal credit cnt clear, 0: non, 1: reset. valid only when dsi_bridge as flow controller</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FIFO_FLOW_STATUS</name>
          <description>dsi bridge raw buffer depth register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>RAW_BUF_DEPTH</name>
              <description>this field configures the depth of dsi_bridge fifo depth</description>
              <bitOffset>0</bitOffset>
              <bitWidth>14</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PIXEL_TYPE</name>
          <description>dsi bridge dpi type control register</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>RAW_TYPE</name>
              <description>this field configures the raw pixel type. 0: rgb888, 1:rgb666, 2:rgb565, 8:yuv444, 9:yuv422, 10:yuv420, 12:gray</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DPI_CONFIG</name>
              <description>this field configures the pixel arrange type of dpi interface</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DATA_IN_TYPE</name>
              <description>input data type, 0: not yuv, 1: yuv</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DPI_TYPE</name>
              <description>this field configures the dpi pixel type. 0: rgb888, 1:rgb666, 2:rgb565</description>
              <bitOffset>7</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DMA_BLOCK_INTERVAL</name>
          <description>dsi bridge dma block interval control register</description>
          <addressOffset>0x1c</addressOffset>
          <size>32</size>
          <resetValue>0x30002409</resetValue>
          <fields>
            <field>
              <name>DMA_BLOCK_SLOT</name>
              <description>this field configures the max block_slot_cnt</description>
              <bitOffset>0</bitOffset>
              <bitWidth>10</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DMA_BLOCK_INTERVAL</name>
              <description>this field configures the max block_interval_cnt, block_interval_cnt increased by 1 when block_slot_cnt if full</description>
              <bitOffset>10</bitOffset>
              <bitWidth>18</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RAW_NUM_TOTAL_AUTO_RELOAD</name>
              <description>this bit configures enable of auto reload reg_raw_num_total, 0: disable, 1: enable</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EN</name>
              <description>this bit configures enable of interval between dma block transfer, 0: disable, 1: enable</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DMA_REQ_INTERVAL</name>
          <description>dsi bridge dma req interval control register</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <resetValue>0x1</resetValue>
          <fields>
            <field>
              <name>DMA_REQ_INTERVAL</name>
              <description>this field configures the interval between dma req events</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DPI_LCD_CTL</name>
          <description>dsi bridge dpi signal control register</description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>DPISHUTDN</name>
              <description>this bit configures dpishutdn signal in dpi interface</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DPICOLORM</name>
              <description>this bit configures dpicolorm signal in dpi interface</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DPIUPDATECFG</name>
              <description>this bit configures dpiupdatecfg signal in dpi interface</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DPI_RSV_DPI_DATA</name>
          <description>dsi bridge dpi reserved data register</description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <resetValue>0x3fff</resetValue>
          <fields>
            <field>
              <name>DPI_RSV_DATA</name>
              <description>this field controls the pixel data sent to dsi_host when dsi_bridge fifo underflow</description>
              <bitOffset>0</bitOffset>
              <bitWidth>30</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DPI_DBG_EN</name>
              <description>Configures data debug feature enable. 0: disable, 1: enable</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DPI_V_CFG0</name>
          <description>dsi bridge dpi v config register 0</description>
          <addressOffset>0x30</addressOffset>
          <size>32</size>
          <resetValue>0x1e0020d</resetValue>
          <fields>
            <field>
              <name>VTOTAL</name>
              <description>this field configures the total length of one frame (by line) for dpi output, must meet: reg_vtotal &gt; reg_vdisp+reg_vsync+reg_vbank</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>VDISP</name>
              <description>this field configures the length of valid line (by line) for dpi output</description>
              <bitOffset>16</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DPI_V_CFG1</name>
          <description>dsi bridge dpi v config register 1</description>
          <addressOffset>0x34</addressOffset>
          <size>32</size>
          <resetValue>0x20021</resetValue>
          <fields>
            <field>
              <name>VBANK</name>
              <description>this field configures the length between vsync and valid line (by line) for dpi output</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>VSYNC</name>
              <description>this field configures the length of vsync (by line) for dpi output</description>
              <bitOffset>16</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DPI_H_CFG0</name>
          <description>dsi bridge dpi h config register 0</description>
          <addressOffset>0x38</addressOffset>
          <size>32</size>
          <resetValue>0x2800320</resetValue>
          <fields>
            <field>
              <name>HTOTAL</name>
              <description>this field configures the total length of one line (by pixel num) for dpi output, must meet: reg_htotal &gt; reg_hdisp+reg_hsync+reg_hbank</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>HDISP</name>
              <description>this field configures the length of valid pixel data (by pixel num) for dpi output</description>
              <bitOffset>16</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DPI_H_CFG1</name>
          <description>dsi bridge dpi h config register 1</description>
          <addressOffset>0x3c</addressOffset>
          <size>32</size>
          <resetValue>0x600030</resetValue>
          <fields>
            <field>
              <name>HBANK</name>
              <description>this field configures the length between hsync and pixel data valid (by pixel num) for dpi output</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>HSYNC</name>
              <description>this field configures the length of hsync (by pixel num) for dpi output</description>
              <bitOffset>16</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DPI_MISC_CONFIG</name>
          <description>dsi_bridge dpi misc config register</description>
          <addressOffset>0x40</addressOffset>
          <size>32</size>
          <resetValue>0x19d0</resetValue>
          <fields>
            <field>
              <name>DPI_EN</name>
              <description>this bit configures enable of dpi output, 0: disable, 1: enable</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>FIFO_UNDERRUN_DISCARD_VCNT</name>
              <description>this field configures the underrun interrupt musk, when underrun occurs and line cnt is less then this field</description>
              <bitOffset>4</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DPI_CONFIG_UPDATE</name>
          <description>dsi_bridge dpi config update register</description>
          <addressOffset>0x44</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>DPI_CONFIG_UPDATE</name>
              <description>write 1 to this bit to update dpi config register MIPI_DSI_BRG_DPI_*</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INT_ENA</name>
          <description>dsi_bridge interrupt enable register</description>
          <addressOffset>0x50</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>UNDERRUN_INT_ENA</name>
              <description>write 1 to enables dpi_underrun_int_st field of MIPI_DSI_BRG_INT_ST_REG controlled by dpi_underrun  interrupt signal</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>VSYNC_INT_ENA</name>
              <description>write 1 to enables dpi_vsync_int_st field of MIPI_DSI_BRG_INT_ST_REG controlled by dpi_vsync  interrupt signal</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INT_CLR</name>
          <description>dsi_bridge interrupt clear register</description>
          <addressOffset>0x54</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>UNDERRUN_INT_CLR</name>
              <description>write 1 to this bit to clear dpi_underrun_int_raw field of MIPI_DSI_BRG_INT_RAW_REG</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>VSYNC_INT_CLR</name>
              <description>write 1 to this bit to clear dpi_vsync_int_raw field of MIPI_DSI_BRG_INT_RAW_REG</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INT_RAW</name>
          <description>dsi_bridge raw interrupt register</description>
          <addressOffset>0x58</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>UNDERRUN_INT_RAW</name>
              <description>the raw interrupt status of dpi_underrun</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>VSYNC_INT_RAW</name>
              <description>the raw interrupt status of dpi_vsync</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INT_ST</name>
          <description>dsi_bridge masked interrupt register</description>
          <addressOffset>0x5c</addressOffset>
