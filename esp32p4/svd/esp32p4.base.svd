        <register>
          <dim>3</dim>
          <dimIncrement>0x68</dimIncrement>
          <name>IN_CRC_INIT_DATA_CH%s</name>
          <description>This register is used to config ch%s crc initial data(max 32 bit)</description>
          <addressOffset>0x48</addressOffset>
          <size>32</size>
          <resetValue>0xffffffff</resetValue>
