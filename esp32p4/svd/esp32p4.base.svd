          <fields>
            <field>
              <name>UNDERRUN_INT_ST</name>
              <description>the masked interrupt status of dpi_underrun</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>VSYNC_INT_ST</name>
              <description>the masked interrupt status of dpi_vsync</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
