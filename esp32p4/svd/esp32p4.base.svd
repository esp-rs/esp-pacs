          <resetValue>0xdedb11</resetValue>
          <fields>
            <field>
              <name>ESC_SEQ1</name>
              <description>Configures the char needing encoding, which is 0x11 as flow control char by default.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ESC_SEQ1_CHAR0</name>
              <description>Configures the first char of SLIP escape character, default value is 0xDB.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ESC_SEQ1_CHAR1</name>
              <description>Configures the second char of SLIP escape character, default value is 0xDE.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ESC_CONF3</name>
          <description>UHCI Escapes Sequence Configuration Register3</description>
          <addressOffset>0x78</addressOffset>
          <size>32</size>
          <resetValue>0xdfdb13</resetValue>
          <fields>
            <field>
              <name>ESC_SEQ2</name>
              <description>Configures the char needing encoding, which is 0x13 as flow control char by default.</description>
