              <bitOffset>10</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SHARP_FILTER2</name>
          <description>sharp usm config register 2</description>
          <addressOffset>0x100</addressOffset>
          <size>32</size>
          <resetValue>0x441</resetValue>
          <fields>
            <field>
              <name>SHARP_FILTER_COE20</name>
              <description>this field configures usm filter coefficient</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SHARP_FILTER_COE21</name>
              <description>this field configures usm filter coefficient</description>
              <bitOffset>5</bitOffset>
