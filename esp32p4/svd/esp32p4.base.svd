              <name>REG_CORE0_WAITI_ICG_EN</name>
              <description>Configures whether cpu core0 waiti signal can control clock gate. If both core0 and core1 waiti_icg_en is 1, then only when core0 and core1 all in waiti will close related clock</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>REG_CORE1_WAITI_ICG_EN</name>
