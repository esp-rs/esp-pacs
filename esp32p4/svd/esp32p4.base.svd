              <access>read-write</access>
            </field>
            <field>
              <name>BLEND_PARAM_CFG_ERR_INT_ENA</name>
              <description>The interrupt enable bit for the PPA_BLEND_PARAM_CFG_ERR_INT interrupt.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INT_CLR</name>
          <description>Interrupt clear bits</description>
          <addressOffset>0x1c</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>SR_EOF_INT_CLR</name>
