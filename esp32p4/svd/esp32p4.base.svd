          <size>32</size>
          <resetValue>0x3430342a</resetValue>
          <fields>
            <field>
              <name>ICM_REG_VERID</name>
              <description>NA</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>HW_CFG</name>
          <description>NA</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <resetValue>0x70d151</resetValue>
          <fields>
            <field>
              <name>ICM_REG_AXI_HWCFG_QOS_SUPPORT</name>
              <description>NA</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ICM_REG_AXI_HWCFG_APB3_SUPPORT</name>
              <description>NA</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ICM_REG_AXI_HWCFG_AXI4_SUPPORT</name>
              <description>NA</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ICM_REG_AXI_HWCFG_LOCK_EN</name>
              <description>NA</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ICM_REG_AXI_HWCFG_TRUST_ZONE_EN</name>
              <description>NA</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
