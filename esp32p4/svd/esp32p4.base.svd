\\1: Applied by software</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ONE_BLOCK</name>
          <description>One block message register</description>
          <addressOffset>0xf4</addressOffset>
          <size>32</size>
